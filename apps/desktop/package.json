{
  "name": "@knowtion/desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Knowtion, a local-first knowledge workspace",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.node.json && node scripts/copy-preload.mjs",
    "dev": "vite build --watch",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "release": "npm run build && electron-builder --config electron-builder.yml --publish always"
  },
  "dependencies": {
    "@knowtion/editor": "*",
    "@knowtion/exporters": "*",
    "@knowtion/engine": "*",
    "@knowtion/format": "*",
    "@knowtion/importers": "*",
    "@knowtion/readmodel": "*",
    "@knowtion/sync": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "type": "module",
  "author": "Knowtion Contributors"
}
