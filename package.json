{
  "name": "knowtion",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source, local-first knowledge workspace",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licences": "node scripts/check-licences.mjs",
    "verify": "npm run typecheck && npm run lint && npm run licences && npm run test",
    "licences:report": "node scripts/write-third-party.mjs",
    "fixtures": "npm run build && node packages/format/scripts/make-fixtures.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "loro-prosemirror": "^0.4.4",
    "prettier": "^3.9.6",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  }
}
